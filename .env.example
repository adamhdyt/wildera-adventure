# Prisma CLI membaca DATABASE_URL dari root .env atau environment proses.
# npm run db:local:start membuat kredensial acak dan root .env jika URL belum ada.
# Untuk PostgreSQL yang disiapkan sendiri, ganti password dan URL contoh ini.
DATABASE_URL=postgresql://wildera:replace_me@127.0.0.1:55432/wildera_development?schema=public
SESSION_SECRET=replace_with_at_least_32_random_characters

# Wajib untuk db:seed dan db:reset. Gunakan nilai development sendiri (minimal 12 karakter).
SEED_ADMIN_PASSWORD=replace_with_a_local_development_password
SEED_ADMIN_EMAIL=admin@wildera.test
SEED_ADMIN_NAME=Admin Wildera
