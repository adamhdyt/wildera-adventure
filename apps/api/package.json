{
  "name": "@wildera/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"node --env-file-if-exists=.env -r ts-node/register src/main.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node -r ts-node/register --test test/*.test.ts",
    "test:db": "node --env-file-if-exists=../../.env -r ts-node/register --test test/database/*.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.3",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "12.0.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@wildera/types": "*",
    "@wildera/validation": "*",
    "argon2": "0.45.1",
    "pg": "8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@wildera/config": "*",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2"
  }
}
