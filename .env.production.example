# ==============================================================================
# WILDERA ADVENTURE — PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# ==============================================================================
# Panduan konfigurasi lingkungan produksi Wildera Adventure.
# Salin file ini ke .env di server produksi dan isi seluruh variabel dengan nilai rahasia nyata.

# ------------------------------------------------------------------------------
# 1. RUNTIME & SYSTEM
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3001
WEB_PORT=3000

# ------------------------------------------------------------------------------
# 2. DATABASE (POSTGRESQL WITH SSL)
# ------------------------------------------------------------------------------
# Gunakan connection string dengan mode SSL require untuk koneksi production DB yang aman.
DATABASE_URL=postgresql://wildera_prod_user:SECURE_PASSWORD@prod-db.internal:5432/wildera_production?sslmode=require&schema=public&connection_limit=20&pool_timeout=10

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Kunci rahasia minimal 64 karakter acak untuk enkripsi session cookie (HttpOnly, Secure, SameSite=Lax).
# Hasilkan dengan: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_MINIMUM_64_CHARACTER_RANDOM_SECRET_KEY

# ------------------------------------------------------------------------------
# 4. DOMAIN, URL & CORS
# ------------------------------------------------------------------------------
SITE_URL=https://wildera.id
NEXT_PUBLIC_SITE_URL=https://wildera.id
NEXT_PUBLIC_API_URL=https://wildera.id/api/v1
CORS_ORIGIN=https://wildera.id

# ------------------------------------------------------------------------------
# 5. INITIAL PRODUCTION SUPER ADMIN SEEDER
# ------------------------------------------------------------------------------
# Digunakan saat menjalankan npm run db:seed:prod pertama kali.
PROD_ADMIN_EMAIL=admin@wildera.id
PROD_ADMIN_NAME=Super Admin Wildera
PROD_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PRODUCTION_PASSWORD_MIN_16_CHARS

# ------------------------------------------------------------------------------
# 6. OFFICIAL BUSINESS CONTACTS
# ------------------------------------------------------------------------------
PROD_WHATSAPP=6281234567890
PROD_EMAIL=halo@wildera.id
PROD_INSTAGRAM=https://instagram.com/wildera.adventure

# ------------------------------------------------------------------------------
# 7. S3 COMPATIBLE OBJECT STORAGE (CLOUDFLARE R2 / AWS S3)
# ------------------------------------------------------------------------------
# Digunakan untuk media upload berskala produksi.
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=wildera-production-media
S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_ACCESS_KEY
S3_PUBLIC_URL=https://media.wildera.id
